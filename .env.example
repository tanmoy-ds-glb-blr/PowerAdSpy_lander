# ==============================================================================
# PowerAdSpy Landers - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Note: '.env' is ignored by git to prevent leaking secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Bright Data Proxy Credentials (Required when BRIGHT_PROXIES: true)
# ------------------------------------------------------------------------------
# Your Bright Data customer/zone username prefix (the code appends -country-<iso>)
# Example: lum-customer-hl_abc123-zone-isp_proxy1
BRIGHT_DATA_CUSTOMER=your_bright_data_customer_here

# Your Bright Data proxy password
BRIGHT_DATA_PASSWORD=your_bright_data_password_here

# ------------------------------------------------------------------------------
# 2. Browser & Crawler Execution Settings
# ------------------------------------------------------------------------------
# Headless browser mode: true (silent background), false (visual popup for debugging)
HEADLESS=true

# Optional: Custom browser user agent string (leave empty for default Chrome UA)
BROWSER_USER_AGENT=

# ------------------------------------------------------------------------------
# 3. Prometheus Metrics & System Monitoring
# ------------------------------------------------------------------------------
# Directory for multi-process Prometheus metrics aggregation (defaults to temp directory)
prometheus_multiproc_dir=

# ------------------------------------------------------------------------------
# 4. Optional / Deployment Credentials
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) for remote server git deployments
GITHUB_PAT=
